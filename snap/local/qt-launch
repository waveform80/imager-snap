#!/bin/sh
set -eu

# Run after the GNOME desktop launcher. Our Qt installation uses upstream's
# directory layout, rather than the distribution's multiarch Qt directories.
export LD_LIBRARY_PATH="$SNAP/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$SNAP/usr/plugins"
export QML_IMPORT_PATH="$SNAP/usr/qml"
export QML2_IMPORT_PATH="$QML_IMPORT_PATH"

exec "$@"
